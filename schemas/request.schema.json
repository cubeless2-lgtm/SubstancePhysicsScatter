{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Physics Scatter worker request v2",
  "type":"object",
  "required":["schema_version","job_id","operation","worker_version","pose_format_version","physics_contract_version","bake_contract_version","physics_input_format_version","physics_input_hash","key_scheme","physics_inputs_path","assets","simulation_key","output_directory","simulation","bake"],
  "properties":{
    "schema_version":{"const":2},
    "worker_version":{"const":"0.3.0"},
    "pose_format_version":{"const":1},"physics_contract_version":{"const":2},"bake_contract_version":{"const":2},"physics_input_format_version":{"enum":[1,2]},
    "scatter_mask":{"oneOf":[{"type":"null"},{"$ref":"mask.schema.json"}]},
    "physics_input_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "physics_inputs_path":{"type":"string"},
    "key_scheme":{"enum":["physics_input_v1","legacy_0_2_0"]},
    "job_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "operation":{"enum":["simulate_bake","simulate","bake"]},
    "assets":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object","required":["asset_id","path","content_hash","format","weight","scale"],"properties":{"asset_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"path":{"type":"string"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"format":{"const":"obj"},"weight":{"type":"number","minimum":0},"scale":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},
    "simulation_key":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "output_directory":{"type":"string"},
    "poses_path":{"type":"string"},
    "simulation":{"type":"object","additionalProperties":false,"required":["count","width","depth","seconds","seed","edges","friction","restitution"],"properties":{"count":{"type":"integer","minimum":1,"maximum":5000},"width":{"type":"number","minimum":0.1,"maximum":1000},"depth":{"type":"number","minimum":0.1,"maximum":1000},"seconds":{"type":"number","minimum":0.1,"maximum":120},"seed":{"type":"integer","minimum":0,"maximum":4294967295},"friction":{"type":"number","minimum":0,"maximum":2},"restitution":{"type":"number","minimum":0,"maximum":1},"placement_jitter":{"type":"boolean"},"edges":{"enum":["open","walls"]}}},
    "bake":{"type":"object","properties":{"resolution":{"type":"integer","minimum":16,"maximum":8192},"normal":{"enum":["DirectX","OpenGL"]}}}
  },
  "allOf":[
    {"if":{"properties":{"operation":{"enum":["simulate_bake","simulate"]}}},"then":{"required":["scatter_mask"],"properties":{"physics_input_format_version":{"const":2}}}},
    {"if":{"properties":{"physics_input_format_version":{"const":1}}},"then":{"properties":{"scatter_mask":{"type":"null"},"operation":{"const":"bake"}}}}
  ]
}
